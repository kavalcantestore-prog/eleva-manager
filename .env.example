# ELEVA Manager — Variáveis de Ambiente

# OpenAI API (Geração de Copy, Imagens, Mensagens)
OPENAI_API_KEY=sk-proj-xxx

# Google Maps API (Prospecção com Mapa)
GOOGLE_MAPS_API_KEY=AIza...

# Banco de Dados (Railway Volume)
DB_PATH=/data/eleva.db

# Porta da Aplicação
PORT=8000

# Ambiente
ENVIRONMENT=production
